// /etc/polkit-1/rules.d/50-sampler-udisks.rules
// Lets the user that runs the sampler mount, unmount and power off USB drives with udisks, without a desktop session
// (the sampler runs as a service with no logged-in desktop, where polkit would otherwise refuse).
// Install:  sudo cp 50-sampler-udisks.rules /etc/polkit-1/rules.d/ && sudo usermod -aG plugdev $USER   (then reboot)
polkit.addRule(function(action, subject) {
    if ((action.id.indexOf("org.freedesktop.udisks2.filesystem-mount") == 0 ||
         action.id.indexOf("org.freedesktop.udisks2.filesystem-unmount-others") == 0 ||
         action.id.indexOf("org.freedesktop.udisks2.power-off-drive") == 0 ||
         action.id.indexOf("org.freedesktop.udisks2.eject-media") == 0) &&
        subject.isInGroup("plugdev")) {
        return polkit.Result.YES;
    }
});
