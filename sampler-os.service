# Starts the sampler at boot.  Install:  sudo cp sampler-os.service /etc/systemd/system/
#                                       sudo systemctl enable --now sampler-os
# Edit User and the paths if your username is not "pi" or the folder is elsewhere.
[Unit]
Description=Monolith
After=sound.target

[Service]
User=pi
SupplementaryGroups=video audio dialout input gpio
WorkingDirectory=/home/pi/sampler-os
ExecStart=/usr/bin/python3 /home/pi/sampler-os/sampler_os.py --device 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
